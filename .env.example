# Copy this file to .env and fill in what you have. Everything here is OPTIONAL —
# any variable left blank means that piece of the app stays in simulated/paper mode.
# .env is gitignored; settings.yaml (non-secret tuning) stays in git, this doesn't.

# --- CORS ---------------------------------------------------------------
# Cross-origin callers allowed to hit the API (same-origin browser tabs never
# need this). Comma-separated. Leave blank to default to the DDEV hostname +
# localhost:8000 — fine for local dev, but set this explicitly for any other
# real deployment.
ALLOWED_ORIGINS=

# --- Kalshi ------------------------------------------------------------
# Market data (prices, volume, order books) needs NO key — it's public.
# Setting these two activates services/kalshi_account_client.py: real,
# read-only access to YOUR account (balance/positions/fills/orders). Order
# placement is a separate config gate — kalshi_account.trading_enabled in
# config/settings.yaml, off by default — so setting these does NOT let
# anything place real orders. See README "Connecting your real Kalshi account".
# Generate both from Kalshi's account settings (docs.kalshi.com -> API Keys).
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Demo and production are separate Kalshi environments with separate
# credentials - a key generated on demo.kalshi.co will NOT authenticate
# against production, and vice versa. Leave blank to use kalshi.base_url
# from config/settings.yaml (production by default). Set this to
# https://external-api.demo.kalshi.co/trade-api/v2 if your key is a demo key.
KALSHI_ACCOUNT_BASE_URL=

# --- Login (optional) ------------------------------------------------------
# Leave all three blank and the app stays fully open, exactly like today — no
# login wall, nothing changes. Set GOOGLE_CLIENT_ID + GOOGLE_CLIENT_SECRET +
# APP_SECRET_KEY together to require Google sign-in before any page or API
# route is reachable.
#
# Create the client ID/secret in Google Cloud Console -> APIs & Services ->
# Credentials -> Create Credentials -> OAuth client ID (type: Web application).
# Add whatever URL you actually use plus "/auth/callback" as an authorized
# redirect URI (e.g. https://kalshi-whale-poc.ddev.site/auth/callback, or
# http://localhost:8000/auth/callback without DDEV) — it must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs session cookies AND encrypts connected-account secrets at rest
# (see services/accounts_store.py). Any long random string works, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET_KEY=
# Optional but recommended for a single-operator app: without this, ANYONE
# who completes Google's consent screen gets in, not just you.
ALLOWED_GOOGLE_EMAIL=

# --- Whale-watcher source --------------------------------------------------
# Selects which provider in services/whalewatchers/ is active. Defaults to
# "kalshi_trade_tape" (real, size-based signal from Kalshi's own public trade
# feed - no credentials needed) if left blank, so this line is optional.
# Set to "generic_rest" and point WHALE_WATCHER_API_URL at a different tool to
# use that instead; leave WHALE_WATCHER_API_URL blank under "generic_rest" to
# fall back to the built-in simulator only.
WHALE_WATCHER_PROVIDER=
WHALE_WATCHER_API_URL=
WHALE_WATCHER_API_KEY=
# Optional: field mappings if the provider's JSON shape differs from
# {ticker, side, size, price} — see services/whalewatchers/generic_rest.py
WHALE_WATCHER_TICKER_FIELD=ticker
WHALE_WATCHER_SIDE_FIELD=side
WHALE_WATCHER_SIZE_FIELD=size
WHALE_WATCHER_PRICE_FIELD=price
