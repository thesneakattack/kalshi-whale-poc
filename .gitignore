.env
CLAUDE.local.md
__pycache__/
*.pyc
.claude/hooks/.checkpoint_nudge_state
.claude/hooks/.aqc_bg_lock
venv/
data/*.db
data/*.db-shm
data/*.db-wal
# services/backup/backup.py's snapshot output - one level below the flat
# data/*.db pattern above, so it needs its own explicit line. Two tiers as
# of 2026-08-30 - see that module's own docstring.
data/backups/
data/backups_large/
# Manual hold area for a data/*.db file quarantined out of the live path
# during an incident (e.g. a corrupted file preserved rather than deleted
# while its replacement goes live) - same one-level-below-the-flat-pattern
# reasoning as data/backups/ above. First used 2026-09-03
# (market_history.db corruption repair).
data/quarantine/
# tools/quality_ratchet.py's own db (renamed from quality_coordination.py 2026-08-27),
# deliberately NOT under data/ - see that module's docstring for why (zero coupling to
# the app's own backup/storage-health mechanisms, which specifically own the data/
# directory).
tools/quality_ratchet_data/
# tools/coordination_engine.py's own db (the new AQC workflow tool, "quality_coordination"
# now names this instead - see that module's docstring). Same reasoning as
# quality_ratchet_data/ above.
tools/quality_coordination_data/
.ddev/.web
.ddev/db_snapshots

# frontend/src/js/*.js is the real, committed source (real ES modules).
# node_modules and the esbuild-produced bundle are both generated - `ddev
# start`'s post-start hook runs `npm install`, and web_extra_daemons' watch
# mode (re)builds the bundle automatically, so neither needs to be committed.
frontend/node_modules/
static/js/dashboard.bundle.js

# Kalshi RSA private key — never commit this, wherever KALSHI_PRIVATE_KEY_PATH points
*.pem
*.key
kalshi_devkey_private.txt

# .github/workflows/quality.yml's architecture-audit job's --json-out
# target - generated per-run, uploaded as a CI artifact, never committed.
build/

# HTTP Basic Auth credentials gating the publicly-tunneled hostname only
# (see .ddev/nginx/kalshi-proxy.conf) - a hashed password, never committed.
.ddev/nginx/.htpasswd

# GitNexus knowledge-graph index - regenerated locally by `gitnexus analyze`,
# machine-specific and large. `.gitnexusrc` (indexOnly:true) IS committed; the
# generated graph itself is not.
.gitnexus/

# pytest-testmon's coverage-fingerprint database (.woodpecker/tests-pytest.yml's
# push-event tier) - persisted per-branch in a Woodpecker cache volume in CI,
# never committed; a local `pytest --testmon` run also drops one here.
.testmondata
