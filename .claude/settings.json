{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" ]; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" session_orient.sh; else bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_orient.sh\"; fi",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" ]; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" post_compact_reorient.sh; else bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_compact_reorient.sh\"; fi",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" ]; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" midsession_checkpoint_nudge.sh; else bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/midsession_checkpoint_nudge.sh\"; fi",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" ]; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" guard_data_db.py; else python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_data_db.py\"; fi",
            "timeout": 5,
            "statusMessage": "Checking for data/*.db writes..."
          },
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" ]; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" guard_workflow.py; fi",
            "timeout": 10,
            "statusMessage": "Workflow guard..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" ]; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" guard_workflow.py; fi",
            "timeout": 10,
            "statusMessage": "Workflow guard..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read|mcp__gitnexus__.*",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" ]; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" guard_workflow.py; fi",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" ]; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" guard_workflow.py; fi",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" ]; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" check_py_syntax.py; else python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/check_py_syntax.py\"; fi",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "if [ -f \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" ]; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_hook.py\" run_tests.py; else python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run_tests.py\"; fi",
            "timeout": 60,
            "statusMessage": "Running tests..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "dimensional-analysis@trailofbits": true,
    "second-opinion@trailofbits": true,
    "42crunch-api-security-testing@42crunch-marketplace": true,
    "chrome-devtools-mcp@chrome-devtools-plugins": true
  },
  "extraKnownMarketplaces": {
    "trailofbits": {
      "source": {
        "source": "github",
        "repo": "trailofbits/skills"
      }
    },
    "42crunch-marketplace": {
      "source": {
        "source": "github",
        "repo": "42Crunch-AI/claude-plugins"
      }
    },
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp",
        "sparsePaths": [
          ".claude-plugin",
          "skills"
        ]
      }
    }
  }
}
